/.android-home/
/.kotlin/
**/.cxx/
/.idea/
/build/
# Module build output only. A bare `**/build/` would also match source directories whose package is
# named `build` (e.g. buildSrc/src/main/kotlin/netboot/build/) and silently drop them from commits.
/*/build/
# Local artifact copies (e.g. the emulator APK) and the workspace-local AVD.
/dist/
/.avd/
/local.properties
*.jks
*.keystore
*.p12
*.pfx
# Local validation artifacts and local-only regression tests. These are intentionally never
# restored to the repository: they exercise device- and host-local rigs that a clean CI checkout
# cannot reproduce. `NativeMediaTest.kt` is deliberately NOT listed here — the FAT32 media
# generation test is committed, and so is the UDF fixture it reads
# (`app/src/androidTest/assets/windows-layout.udf`).
/USB-PXE-VALIDATION.md
/test-support/
/app/src/androidTest/java/com/sky22333/netboot/MainActivityTest.kt
/app/src/androidTest/java/com/sky22333/netboot/data/DownloadIntegrityTest.kt
/app/src/test/java/com/sky22333/netboot/data/UsbMediaLayoutTest.kt
/app/src/test/java/com/sky22333/netboot/download/RemoteFileProbeTest.kt
/app/src/test/java/com/sky22333/netboot/download/TransferValidationTest.kt
/core-go/mobilecore/proxy_test.go
*.hprof
app/libs/*.aar
app/libs/*-sources.jar
